# The gitleaks release that install.sh downloads. To upgrade, change
# GITLEAKS_VERSION and GITLEAKS_SHA256 together.
# The sha256 is the linux_x64 line of the release's
# gitleaks_<version>_checksums.txt.
GITLEAKS_VERSION=8.30.1
GITLEAKS_SHA256=551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb
# sha256 of gitleaks.toml. The tests fail when the file and this pin differ.
GITLEAKS_CONFIG_SHA256=adaff47cc7bcd982bca798a39646c2990f66b1ae135be5f07f5abac19dce974d
